# AdultCam Omega: public HTTPS only; keep backend + OBS private on localhost.
# ADULTCAM_PUBLIC_DOMAIN must correspond to ADULTCAM_PUBLIC_ORIGIN.
{$ADULTCAM_PUBLIC_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
    }
    reverse_proxy 127.0.0.1:8765 {
        header_up Host localhost
    }
}
